generator client {
  provider = "prisma-client-js"
//   output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model user {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String    @unique
  password String
  
  materia  materia[]

  @@map("user")
}

model materia {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  weight     Float
  quantity   Int
  difficulty Int

  user     user @relation(fields: [userId], references: [id])
  userId     String @db.ObjectId

  @@map("materia")
}